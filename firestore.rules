rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return request.auth != null && request.auth.token.email == 'vinicius.machado.carvalho@educacao.mg.gov.br';
    }

    // Escolas: Coleção principal em português e subcoleções vinculadas
    match /escolas/{escolaId} {
      allow read: if true;
      allow write: if true;
    }

    match /escolas/{escolaId}/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Schools: Publicly readable for tenant selection, writable for institutional setup
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if true;
    }

    // Rooms: Readable by teachers and students, managed by staff
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if true;
    }

    // Reservations: Readable by community, writable for creating and modifying bookings
    match /reservations/{reservationId} {
      allow read: if true;
      allow write: if true;
    }

    // Slot Locks: Concurrency control for preventing simultaneous double-booking of same period
    match /slot_locks/{lockId} {
      allow read: if true;
      allow write: if true;
    }

    // Users: Profiles accessible for educational workflow
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Announcements: Notices visible to all users
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    // User Notifications: Alerts for reservation approvals and cancellations
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    // Error Logs: Remote debugging & critical error capture
    match /error_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // Health check and connection test probe
    match /test/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
