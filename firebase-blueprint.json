{
  "entities": {
    "escolas": {
      "title": "Escolas",
      "description": "Coleção de escolas e instituições conectadas com seus dados vinculados",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Identificador único da escola (schoolId)" },
        "name": { "type": "string", "description": "Nome oficial da escola" },
        "shortName": { "type": "string", "description": "Nome abreviado" },
        "code": { "type": "string", "description": "Código da escola ou acrônimo" },
        "city": { "type": "string", "description": "Cidade / Município" },
        "state": { "type": "string", "description": "Estado / UF" },
        "inepCode": { "type": "string", "description": "Código INEP" },
        "networkType": { "type": "string", "description": "Rede (Estadual, Municipal, Privada)" },
        "shifts": { "type": "array", "items": { "type": "string" }, "description": "Turnos em funcionamento" },
        "contactEmail": { "type": "string", "description": "E-mail de contato institucional" },
        "phone": { "type": "string", "description": "Telefone de contato" },
        "directorName": { "type": "string", "description": "Nome da direção" },
        "active": { "type": "boolean", "description": "Status ativo" },
        "createdAt": { "type": "string", "description": "Data de cadastro ISO" },
        "adminEmails": { "type": "array", "items": { "type": "string" }, "description": "E-mails administradores" },
        "requireAdminApproval": { "type": "boolean", "description": "Exigir aprovação prévia" },
        "maxAdvanceDays": { "type": "number", "description": "Dias de antecedência máxima" },
        "allowWeekendBooking": { "type": "boolean", "description": "Permitir agendamento nos fins de semana" },
        "totalSalas": { "type": "number", "description": "Total de salas vinculadas" },
        "totalUsuarios": { "type": "number", "description": "Total de docentes e usuários vinculados" },
        "totalReservas": { "type": "number", "description": "Total de reservas ativas vinculadas" }
      },
      "required": ["id", "name", "shortName", "code", "city", "state", "networkType", "shifts", "contactEmail", "active", "createdAt", "adminEmails"]
    },
    "schools": {
      "title": "Schools",
      "description": "Tenant schools registered in the multi-school system",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique school ID" },
        "name": { "type": "string", "description": "Full school name" },
        "shortName": { "type": "string", "description": "Abbreviated name" },
        "code": { "type": "string", "description": "School code or acronym" },
        "city": { "type": "string", "description": "City" },
        "state": { "type": "string", "description": "State UF" },
        "inepCode": { "type": "string", "description": "MEC INEP code" },
        "networkType": { "type": "string", "description": "School network type (Estadual, Municipal, etc.)" },
        "shifts": { "type": "array", "items": { "type": "string" }, "description": "Active operational shifts" },
        "contactEmail": { "type": "string", "description": "Contact email" },
        "phone": { "type": "string", "description": "Contact phone" },
        "directorName": { "type": "string", "description": "School director name" },
        "active": { "type": "boolean", "description": "Active status flag" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "adminEmails": { "type": "array", "items": { "type": "string" }, "description": "Admin emails authorized" },
        "requireAdminApproval": { "type": "boolean", "description": "Require approval flag" },
        "maxAdvanceDays": { "type": "number", "description": "Max advance days allowed" },
        "allowWeekendBooking": { "type": "boolean", "description": "Allow booking on weekends" }
      },
      "required": ["id", "name", "shortName", "code", "city", "state", "networkType", "shifts", "contactEmail", "active", "createdAt", "adminEmails"]
    },
    "rooms": {
      "title": "Rooms and Labs",
      "description": "Laboratories and pedagogical rooms available for reservations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Room ID" },
        "schoolId": { "type": "string", "description": "ID of the associated school" },
        "name": { "type": "string", "description": "Room or lab name" },
        "type": { "type": "string", "description": "Type of laboratory" },
        "capacity": { "type": "number", "description": "Max student capacity" },
        "location": { "type": "string", "description": "Location in school" },
        "description": { "type": "string", "description": "Description of resources" },
        "status": { "type": "string", "description": "Status ACTIVE, MAINTENANCE, INACTIVE" },
        "equipment": { "type": "array", "items": { "type": "string" }, "description": "List of available equipment" },
        "color": { "type": "string", "description": "Color accent" },
        "iconName": { "type": "string", "description": "Icon identifier" },
        "responsibleName": { "type": "string", "description": "Responsible staff name" },
        "rules": { "type": "array", "items": { "type": "string" }, "description": "Room specific rules" }
      },
      "required": ["id", "name", "type", "capacity", "location", "description", "status", "equipment", "color", "iconName"]
    },
    "reservations": {
      "title": "Reservations",
      "description": "Room and lab reservation bookings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Reservation ID" },
        "schoolId": { "type": "string", "description": "ID of school" },
        "roomId": { "type": "string", "description": "Target room ID" },
        "roomName": { "type": "string", "description": "Target room name" },
        "userId": { "type": "string", "description": "User teacher ID" },
        "userName": { "type": "string", "description": "User teacher name" },
        "userEmail": { "type": "string", "description": "User teacher email" },
        "userAvatar": { "type": "string", "description": "User avatar" },
        "date": { "type": "string", "description": "Booking date YYYY-MM-DD" },
        "shift": { "type": "string", "description": "Shift MANHA, TARDE, NOITE" },
        "periodIds": { "type": "array", "items": { "type": "string" }, "description": "Period IDs booked" },
        "periodNumbers": { "type": "array", "items": { "type": "number" }, "description": "Period numbers" },
        "periodLabels": { "type": "string", "description": "Human readable label" },
        "turma": { "type": "string", "description": "Class grade or turma" },
        "disciplina": { "type": "string", "description": "Curricular discipline" },
        "subjectTopic": { "type": "string", "description": "Class topic/lesson objective" },
        "numberOfStudents": { "type": "number", "description": "Estimated student count" },
        "requestedEquipment": { "type": "array", "items": { "type": "string" }, "description": "Requested equipment" },
        "observations": { "type": "string", "description": "Additional notes" },
        "status": { "type": "string", "description": "CONFIRMED, PENDING, CANCELLED, COMPLETED" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "adminNote": { "type": "string", "description": "Note from administrator" }
      },
      "required": ["id", "roomId", "roomName", "userId", "userName", "userEmail", "date", "shift", "periodIds", "periodNumbers", "periodLabels", "turma", "disciplina", "subjectTopic", "status", "createdAt"]
    },
    "users": {
      "title": "Users",
      "description": "System users, teachers and administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User ID" },
        "name": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "description": "Institutional email" },
        "avatar": { "type": "string", "description": "Avatar URL or initial letter" },
        "iconKey": { "type": "string", "description": "Icon key" },
        "role": { "type": "string", "description": "ADMIN or TEACHER" },
        "subject": { "type": "string", "description": "Teaching subject" },
        "schoolId": { "type": "string", "description": "School ID" },
        "schoolName": { "type": "string", "description": "School Name" },
        "gender": { "type": "string", "description": "MALE or FEMALE" },
        "approvalStatus": { "type": "string", "description": "APPROVED, PENDING, or REJECTED" },
        "approvedAt": { "type": "string", "description": "ISO date string when coordinator approved" },
        "approvedBy": { "type": "string", "description": "Name of coordinator who approved access" },
        "firstLoginAt": { "type": "string", "description": "ISO date of first Google access" }
      },
      "required": ["id", "name", "email", "avatar", "role", "schoolName"]
    },
    "announcements": {
      "title": "Announcements",
      "description": "Institutional notices and announcements",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Notice ID" },
        "schoolId": { "type": "string", "description": "School ID" },
        "title": { "type": "string", "description": "Title" },
        "content": { "type": "string", "description": "Content body" },
        "date": { "type": "string", "description": "Date string" },
        "author": { "type": "string", "description": "Author name" },
        "important": { "type": "boolean", "description": "Priority flag" },
        "targetRoomId": { "type": "string", "description": "Optional specific room ID" }
      },
      "required": ["id", "title", "content", "date", "author", "important"]
    },
    "slot_locks": {
      "title": "Slot Locks",
      "description": "Atomic concurrency locks to prevent double-booking identical room and period slots",
      "type": "object",
      "properties": {
        "lockId": { "type": "string", "description": "Unique lock key" },
        "schoolId": { "type": "string", "description": "School ID" },
        "roomId": { "type": "string", "description": "Room ID" },
        "date": { "type": "string", "description": "Date YYYY-MM-DD" },
        "periodId": { "type": "string", "description": "Period ID" },
        "reservationId": { "type": "string", "description": "Associated reservation ID" },
        "userName": { "type": "string", "description": "Name of booking user" },
        "userEmail": { "type": "string", "description": "Email of booking user" },
        "turma": { "type": "string", "description": "Class grade" },
        "disciplina": { "type": "string", "description": "Discipline" },
        "active": { "type": "boolean", "description": "Active lock flag" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["lockId", "schoolId", "roomId", "date", "periodId", "reservationId", "active", "updatedAt"]
    },
    "error_logs": {
      "title": "Error Logs",
      "description": "Frontend runtime error logs captured automatically for remote debugging",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique error log ID" },
        "message": { "type": "string", "description": "Error message" },
        "category": { "type": "string", "description": "Category: CROSS_ORIGIN, TYPE_ERROR, PROMISE_REJECTION, RUNTIME_ERROR, REACT_ERROR, NETWORK_ERROR, CUSTOM" },
        "severity": { "type": "string", "description": "Severity: CRITICAL, ERROR, WARNING, INFO" },
        "stack": { "type": "string", "description": "JavaScript stack trace" },
        "source": { "type": "string", "description": "File or source URL where error originated" },
        "lineno": { "type": "number", "description": "Line number" },
        "colno": { "type": "number", "description": "Column number" },
        "componentStack": { "type": "string", "description": "React component stack trace" },
        "url": { "type": "string", "description": "Window location URL when error occurred" },
        "path": { "type": "string", "description": "URL pathname" },
        "origin": { "type": "string", "description": "Window origin" },
        "isIframe": { "type": "boolean", "description": "Whether error occurred inside an iframe" },
        "userAgent": { "type": "string", "description": "Browser user agent" },
        "timestamp": { "type": "string", "description": "ISO timestamp" },
        "userEmail": { "type": "string", "description": "Email of user if authenticated" },
        "userId": { "type": "string", "description": "User ID if authenticated" },
        "schoolId": { "type": "string", "description": "School ID context" }
      },
      "required": ["id", "message", "category", "severity", "url", "timestamp"]
    },
    "notifications": {
      "title": "Notifications",
      "description": "Alertas e notificações para professores sobre reservas aprovadas ou canceladas",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique notification ID" },
        "userId": { "type": "string", "description": "Target teacher user ID" },
        "userEmail": { "type": "string", "description": "Target teacher user email" },
        "schoolId": { "type": "string", "description": "School ID context" },
        "type": { "type": "string", "description": "Notification type (RESERVATION_APPROVED, RESERVATION_CANCELLED, RESERVATION_REJECTED, INFO)" },
        "title": { "type": "string", "description": "Notification title" },
        "message": { "type": "string", "description": "Notification description text" },
        "reservationId": { "type": "string", "description": "Associated reservation ID" },
        "roomName": { "type": "string", "description": "Name of the room" },
        "date": { "type": "string", "description": "Date of reservation ISO" },
        "periodLabels": { "type": "string", "description": "Period labels" },
        "adminName": { "type": "string", "description": "Name of administrator who approved or cancelled" },
        "adminNote": { "type": "string", "description": "Administrator note or cancellation reason" },
        "read": { "type": "boolean", "description": "Read status flag" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "userId", "userEmail", "type", "title", "message", "roomName", "date", "read", "createdAt"]
    }
  },
  "enums": {
    "UserRole": {
      "description": "User roles in the system",
      "values": ["ADMIN", "TEACHER"]
    },
    "SpaceType": {
      "description": "Types of spaces",
      "values": ["INFORMATICA", "CIENCIAS", "QUIMICA_FISICA", "MAKER", "MULTIMIDIA"]
    },
    "ShiftType": {
      "description": "Operational shifts",
      "values": ["MANHA", "TARDE", "NOITE"]
    },
    "ReservationStatus": {
      "description": "Booking status",
      "values": ["CONFIRMED", "PENDING", "CANCELLED", "COMPLETED"]
    }
  },
  "firestore": {
    "/escolas/{escolaId}": {
      "schema": "escolas",
      "description": "Coleção principal de escolas cadastradas e linkadas aos seus respectivos dados"
    },
    "/escolas/{escolaId}/salas/{salaId}": {
      "schema": "rooms",
      "description": "Salas e laboratórios vinculados a cada escola"
    },
    "/escolas/{escolaId}/reservas/{reservaId}": {
      "schema": "reservations",
      "description": "Reservas efetuadas vinculadas a cada escola"
    },
    "/escolas/{escolaId}/usuarios/{usuarioId}": {
      "schema": "users",
      "description": "Usuários e professores vinculados a cada escola"
    },
    "/schools/{schoolId}": {
      "schema": "schools",
      "description": "Escolas registradas no sistema multi-institucional"
    },
    "/rooms/{roomId}": {
      "schema": "rooms",
      "description": "Salas e laboratórios de todas as escolas com chave schoolId"
    },
    "/reservations/{reservationId}": {
      "schema": "reservations",
      "description": "Reservas com chave schoolId"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "Usuários do sistema vinculados ao seu schoolId"
    },
    "/announcements/{announcementId}": {
      "schema": "announcements",
      "description": "Avisos institucionais vinculados ao schoolId"
    },
    "/slot_locks/{lockId}": {
      "schema": "slot_locks",
      "description": "Travas de concorrência atômicas por escola, sala, data e período"
    },
    "/error_logs/{logId}": {
      "schema": "error_logs",
      "description": "Logs de erros críticos capturados no frontend para depuração remota"
    },
    "/notifications/{notificationId}": {
      "schema": "notifications",
      "description": "Alertas e notificações para professores sobre reservas aprovadas ou canceladas"
    }
  }
}
